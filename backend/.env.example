# Optional environment variable; the server does not automatically load .env.
AGENTLAB_LISTEN_ADDR=127.0.0.1:8787
# Real Agent testing only. Keep credentials in .env.dev, which is ignored.
BASE_URL=https://api.example.com/v1/chat/completions
API_KEY=
AGENTLAB_MODEL_PROVIDER=openai-compatible
AGENTLAB_GUEST_IMAGE=agentlab/student-guest:20261024
# Default auto-probe; set 0 to explicitly disable student execution for CRUD-only tests.
AGENTLAB_LEARNING_EXECUTOR_READY=1
AGENTLAB_AGENT_IMAGE=agentlab/agents:validated-20261023
AGENTLAB_MONGO_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true
AGENTLAB_MONGO_DATABASE=agentlab
# Optional host-side credential root key: base64 of 32 random bytes, shared by all API/workers.
AGENTLAB_CREDENTIAL_KEY=
# Otherwise uses the user config directory; Windows DPAPI, Unix owner-only file.
AGENTLAB_CREDENTIAL_KEY_FILE=
# Explicit private/test gateway origins, comma-separated. Never supplied by the browser.
AGENTLAB_CONNECTION_ALLOWED_ORIGINS=

# ---- Hosted Agent and Tools API (backend/internal/platform) ----
# What this process does: all (default) serves the API and runs the worker; api serves HTTP only;
# worker executes runs only. Scale out by starting more api or worker processes with these same settings.
AGENTLAB_ROLE=all
# Optional listener for the machine API only (/v1, /healthz, /readyz). It accepts API keys, never browser
# cookies, and is the one to put behind a TLS-terminating proxy. Leave empty to serve /v1 on the local API.
AGENTLAB_PLATFORM_LISTEN_ADDR=
# Where uploaded and generated files live. fs is a directory; share one volume between nodes.
AGENTLAB_BLOB_BACKEND=fs
# Defaults to AgentLab/blobs inside the user cache directory.
AGENTLAB_BLOB_DIR=
# Code execution: docker (default) or none, which disables code.execute. It never falls back to the host.
AGENTLAB_SANDBOX_BACKEND=docker
# Build with: pnpm build:sandbox
AGENTLAB_SANDBOX_IMAGE=agentlab/sandbox-python:20261024
# Optional stronger isolation, for example runsc (gVisor) or kata-runtime. Reported honestly in /capabilities.
AGENTLAB_SANDBOX_RUNTIME=
# Node ceilings. Run resourceProfile can request a smaller fixed allocation; unsupported sizes are refused.
# To enable the 2 vCPU / 4 GiB preset use ceilings >= 2 / 4096. GPU execution is not implemented.
AGENTLAB_SANDBOX_CPUS=1
AGENTLAB_SANDBOX_MEMORY_MB=1024
# Concurrent containers on this node. Add nodes for more capacity.
AGENTLAB_SANDBOX_SLOTS=2
# Defaults to hostname-pid. Give each worker a stable, unique name if you want readable logs.
AGENTLAB_WORKER_ID=
# Runs executed at once by one worker process.
AGENTLAB_WORKER_CONCURRENCY=4
AGENTLAB_WORKER_POLL_MS=1000
# A run's lease is renewed every third of this; a worker that disappears is recovered after it lapses.
AGENTLAB_RUN_LEASE_SECONDS=60
# On shutdown, how long running work may finish before it is left to lease recovery.
# Give the process a termination grace period at least this long.
AGENTLAB_DRAIN_SECONDS=90
AGENTLAB_RECOVER_SECONDS=15
AGENTLAB_RUN_MAX_ATTEMPTS=3
AGENTLAB_MODEL_TIMEOUT_SECONDS=120
AGENTLAB_MODEL_SEND_RETRIES=2
# Defaults for new projects and API keys.
AGENTLAB_DEFAULT_CURRENCY=CNY
AGENTLAB_PROJECT_MAX_CONCURRENT_RUNS=10
AGENTLAB_ARTIFACT_RETENTION_DAYS=30
# Per API key, counted separately by each API process (see docs/implementation-status.md).
AGENTLAB_DEFAULT_RATE_PER_MINUTE=600
AGENTLAB_MAX_UPLOAD_MB=25
AGENTLAB_MAX_RUN_INPUT_MB=100
# The workspace name shown in the workbench shell and settings (1-60 characters).
AGENTLAB_WORKSPACE_NAME=AgentLab 工作区
# How often a worker samples what each project keeps stored (1-86400 seconds). Usage keeps one line
# per project and UTC day whatever the interval, so a shorter one only brings the day's line sooner.
AGENTLAB_STORAGE_SAMPLE_SECONDS=3600
