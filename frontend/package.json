{
  "name": "@agentlab/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "contracts": "openapi-typescript ../contracts/openapi.yaml -o src/api/generated.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:e2e:platform": "playwright test --config playwright.platform.config.ts",
    "test:e2e:p1": "playwright test --config playwright.p1.config.ts",
    "test:e2e:p1:regression": "playwright test --config playwright.p1-regression.config.ts",
    "test:e2e:p1:acceptance": "playwright test --config playwright.p1-acceptance.config.ts",
    "test:e2e:acceptance": "playwright test --config playwright.acceptance.config.ts",
    "dev:acceptance": "node tests/live-platform/start-api.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "katex": "0.16.47",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  }
}
