{
  "schemaVersion": "1.0",
  "designVersion": "3.1.0",
  "direction": "black-geek-console",
  "status": "implemented-mvp-runtime",
  "designSpec": "../DESIGN.md",
  "runtimeDestination": "../frontend/src/design-tokens.css",
  "automaticallyImported": false,
  "colorScheme": "dark",
  "colors": {
    "--al-color-canvas": "#080B10",
    "--al-color-surface": "#10151E",
    "--al-color-surface-subtle": "#0C1119",
    "--al-color-surface-raised": "#18202D",
    "--al-color-border": "#263244",
    "--al-color-input-border": "#627594",
    "--al-color-text": "#E6EDF7",
    "--al-color-text-muted": "#9CAEC5",
    "--al-color-primary": "#38D9FF",
    "--al-color-primary-hover": "#72E5FF",
    "--al-color-primary-active": "#20B8DE",
    "--al-color-primary-subtle": "#102E3A",
    "--al-color-on-primary": "#061018",
    "--al-color-accent": "#A78BFA",
    "--al-color-accent-subtle": "#241C3A",
    "--al-color-success": "#4ADE80",
    "--al-color-warning": "#FBBF24",
    "--al-color-danger": "#F87171",
    "--al-color-info": "#60A5FA",
    "--al-color-disabled-text": "#8795A9",
    "--al-color-workspace-bg": "#05080D",
    "--al-color-workspace-text": "#D8E3F0",
    "--al-color-focus": "#38D9FF",
    "--al-color-success-subtle": "#0E2618",
    "--al-color-warning-subtle": "#2A2110",
    "--al-color-danger-subtle": "#2A1517",
    "--al-color-info-subtle": "#111F31",
    "--al-color-primary-line": "rgb(56 217 255 / 38%)",
    "--al-color-accent-line": "rgb(167 139 250 / 38%)",
    "--al-color-border-soft": "rgb(38 50 68 / 58%)",
    "--al-color-overlay": "rgb(4 7 11 / 76%)",
    "--al-color-grid-line": "rgb(56 217 255 / 6%)"
  },
  "spacing": {
    "--al-space-1": "4px",
    "--al-space-2": "8px",
    "--al-space-3": "12px",
    "--al-space-4": "16px",
    "--al-space-5": "20px",
    "--al-space-6": "24px",
    "--al-space-8": "32px",
    "--al-space-10": "40px",
    "--al-space-12": "48px",
    "--al-space-16": "64px"
  },
  "sizes": {
    "--al-control-height": "40px",
    "--al-control-height-sm": "32px",
    "--al-control-height-touch": "44px",
    "--al-sidebar-width": "240px",
    "--al-topbar-height": "56px",
    "--al-content-width": "1440px",
    "--al-reading-width": "760px"
  },
  "radii": {
    "--al-radius-sm": "4px",
    "--al-radius-control": "6px",
    "--al-radius-card": "10px",
    "--al-radius-panel": "12px"
  },
  "typography": {
    "--al-font-sans": "'Segoe UI', 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif",
    "--al-font-mono": "'Cascadia Code', 'JetBrains Mono', Consolas, monospace",
    "--al-text-xs": "12px",
    "--al-text-sm": "14px",
    "--al-text-ui": "15px",
    "--al-text-base": "16px",
    "--al-text-lg": "18px",
    "--al-text-xl": "20px",
    "--al-text-2xl": "28px",
    "--al-text-3xl": "32px",
    "--al-leading-ui": 1.6,
    "--al-leading-heading": 1.25
  },
  "motion": {
    "--al-duration-fast": "120ms",
    "--al-duration-normal": "180ms",
    "--al-ease": "cubic-bezier(0.22, 1, 0.36, 1)",
    "reducedMotion": "Disable nonessential motion under prefers-reduced-motion."
  },
  "effects": {
    "--al-border-width": "1px",
    "--al-shadow-raised": "0 12px 32px rgb(0 0 0 / 30%)",
    "--al-shadow-dialog": "0 16px 48px rgb(0 0 0 / 45%)",
    "--al-shadow-focus": "0 0 0 3px rgb(56 217 255 / 18%)",
    "focusOutlineWidth": "2px",
    "focusOutlineOffset": "2px",
    "rules": "No persistent scanlines, blinking decoration, clay depth or large neon gradients."
  },
  "layers": {
    "--al-z-base": 0,
    "--al-z-sticky": 10,
    "--al-z-popover": 20,
    "--al-z-dialog": 40,
    "--al-z-toast": 50
  }
}
